# MySQL credentials
MYSQL_DATABASE=instrumentdb
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# RabbitMQ credentials (do NOT use guest/guest)
RABBITMQ_DEFAULT_USER=rabbitapp
RABBITMQ_DEFAULT_PASS=change_me_rabbit_password

# Config Monitor Webhook Secret
CONFIG_MONITOR_WEBHOOK_SECRET=change_me_webhook_secret

# Optional Git repository for Config Server (if spring.profiles.active=git)
CONFIG_REPO_GIT_URI=https://github.com/your-username/config-repo.git
CONFIG_REPO_GIT_USERNAME=
CONFIG_REPO_GIT_PASSWORD=
